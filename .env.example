DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PORT=3307
## 仅供测试；上线前设置正式冷静期（秒）。
LETTER_COOLDOWN_SECONDS=3
REDIS_PASSWORD=replace-with-a-local-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
## 部署到域名后改为明确的 HTTPS 来源，例如 https://example.com。
WS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
